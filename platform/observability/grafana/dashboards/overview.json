    {
     "expr": "container_cpu_percent",
     "refId": "C",
     "format": "table",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto"
     }
    },
    "overrides": []
   },
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true,
       "Value #A": true
      },
      "renameByName": {
       "name": "container",
       "group": "group",
       "image": "image",
       "state": "state",
       "Value #B": "memory (bytes)",
       "Value #C": "cpu %",
       "Value #A": "up"
