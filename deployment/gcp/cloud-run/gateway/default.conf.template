server {
    listen 80;

    # Photo uploads go through here to the backend.
    client_max_body_size 12m;

    location /api/ {
        # No URI part in proxy_pass: the request path is forwarded unchanged. Cloud Run (and the emulator's
        # front door) routes by the Host header, so it is set to the target service's own host.
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host ${BACKEND_HOST};
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass ${FRONTEND_URL};
        proxy_set_header Host ${FRONTEND_HOST};
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
