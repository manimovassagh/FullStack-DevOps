 "templating": {
  "list": [
   {
    "name": "testid",
    "label": "Test run",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prom"
    },
    "query": {
     "query": "label_values(k6_vus, testid)",
     "refId": "q"
    },
    "definition": "label_values(k6_vus, testid)",
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "allValue": ".*",
    "sort": 2
   }
  ]
 },
