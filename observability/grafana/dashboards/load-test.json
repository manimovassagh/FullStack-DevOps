      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "expr": "sum(rate(k6_http_reqs_total{testid=~\"$testid\"}[30s]))",
     "legendFormat": "requests / s",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
