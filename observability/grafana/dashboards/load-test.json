{
 "uid": "load-test",
 "title": "Plant Parent \u00b7 load test (k6)",
 "tags": [
  "plant-parent",
  "k6"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Virtual users",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(k6_vus{testid=~\"$testid\"})",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "fixed",
      "fixedColor": "purple"
     },
     "noValue": "\u2013"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Requests / s",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(rate(k6_http_reqs_total{testid=~\"$testid\"}[30s]))",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     },
     "noValue": "\u2013",
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "p95 latency",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "max(k6_http_req_duration_p95{testid=~\"$testid\",expected_response=\"true\"})",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "thresholds"
     },
     "noValue": "\u2013",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.3
       },
       {
        "color": "red",
        "value": 0.5
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Error rate",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "max(k6_http_req_failed_rate{testid=~\"$testid\"})",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "thresholds"
     },
     "noValue": "\u2013",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.005
       },
       {
        "color": "red",
        "value": 0.01
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
